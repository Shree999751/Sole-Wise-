# Shoes Wise - Environment Configuration Example

# Database URL:
# For local zero-config SQLite:
DATABASE_URL=sqlite:///./shoes_wise.db

# For Production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/shoes_wise

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# Security / Session (if connecting external auth like Firebase / Auth0)
AUTH_PROVIDER=local
SECRET_KEY=change-this-in-production-random-secret-key-32-chars

